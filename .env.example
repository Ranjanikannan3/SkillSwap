# SkillSwap Configuration Example
PORT=3000

# MongoDB Connection String:
# For local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/skillswap
# For MongoDB Atlas (replace <username>, <password>, <cluster-url>):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/skillswap?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Node Environment (development / production)
NODE_ENV=development
